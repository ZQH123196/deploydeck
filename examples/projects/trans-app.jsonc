// 项目清单：trans_app。
// 它随被部署的项目走，不进 deploydeck 仓库。
// 步骤不写在这里：引擎按 Profile 的两个脚本与本文件的 healthCheck 生成内置步骤。
{
  "id": "trans-app",
  "repository": {
    "url": "git@github.com:ZQH123196/trans_app.git",
    "branch": "main"
  },
  "workdir": "/root/trans_app",

  // 部署后的健康检查。退出码 0 即通过。
  "healthCheck": "curl -fsS http://127.0.0.1:6006/health"
}
