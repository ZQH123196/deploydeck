// 部署配置：线上生产用。
// 与开发配置的差别全部写在这里，引擎不按「开发/生产」分支判断。
{
  "id": "trans-prod",
  "project": "trans-app",
  "provider": "autodl",
  "instanceNamePattern": "trans-prod",
  "gpuPreference": ["pro6000-p", "v-48g"],
  "regionPreference": [],
  "cloneDataDisk": true,

  // 克隆源实例：生产用的模板机，保持关机。
  "cloneSourceInstanceName": "trans-prod",
  "ttlMinutes": 480,
  "budgetCapYuan": 200,

  // 部署失败后实例立即销毁。依次执行关机、释放、验证消失。
  "onDeployFailure": "destroy-container",

  // 生产必须锁定 commit。线上跑的是哪份代码必须可追溯。
  "requirePinnedCommit": true,

  "deployScript": "scripts/deploy.sh",
  "startScript": "scripts/start.sh"
}
