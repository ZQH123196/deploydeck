// 部署配置：线上生产用。
// 与开发配置的差别全部写在这里，引擎不按「开发/生产」分支判断。
{
  "id": "trans-prod",
  "project": "trans-app",
  "provider": "autodl",
  "instanceNamePattern": "trans-prod",
  "gpuPreference": ["pro6000-p", "v-48g"],
  "regionPreference": [],
  "cloneDataDisk": true,

  // 开机形态：有卡。生产要真算力，不能走无卡模式。
  "powerOnMode": "gpu",

  // 克隆源实例：生产用的模板机，保持关机。
  "cloneSourceInstanceName": "trans-prod",
  "ttlMinutes": 480,
  "budgetCapYuan": 200,

  // 部署失败后容器怎么办。当前两个取值行为相同：保留容器并停机，不自动销毁。
  // 销毁入口只有 teardown 命令一条；失败时容器要留下来给人查现场。
  // 这里保留 destroy-container 只为不改动既有生产配置的取值。
  "onDeployFailure": "destroy-container"
}
